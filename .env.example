APP_ENV=development
APP_NAME=D&D Compendium
DATABASE_URL=sqlite:///./data/compendium.sqlite3
ASSET_ROOT=./data/assets
OPEN5E_API_ROOT=https://api.open5e.com/v2/
OPEN5E_ENDPOINTS=
OPEN5E_PAGE_SIZE=50
OPEN5E_COMMIT_EVERY=50
OPEN5E_REQUEST_DELAY=0.75
OPEN5E_ENDPOINT_DELAY=2.0
OPEN5E_RETRY_ATTEMPTS=5
OPEN5E_RETRY_BASE_DELAY=2.0
OPEN5E_RETRY_MAX_DELAY=60.0
SECRET_KEY=change-me

# Authentication
SECRET_KEY=replace-with-a-long-random-value
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-now
SESSION_COOKIE_NAME=dnd_compendium_session
SESSION_MAX_AGE=1209600
SESSION_HTTPS_ONLY=false
